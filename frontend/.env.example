# MARGA environment variables (copy to frontend/.env to use). None are required:
# the app runs fully offline with the in-browser engine and the bundled terrain package.

# Optional: route through the Python engine service instead of the in-browser engine.
# Start it with:  cd engine && .venv\Scripts\python -m marga_engine serve --port 8000
# If the service does not answer, the app falls back to the in-browser engine automatically.
# VITE_ENGINE_API_URL=http://localhost:8000
